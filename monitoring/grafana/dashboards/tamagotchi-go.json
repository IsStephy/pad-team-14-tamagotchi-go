{
  "uid": "tamagotchi-go",
  "title": "Tamagotchi Go",
  "description": "The whole system: requests, errors, latency, load per replica, circuit breakers, broker queues and logs.",
  "tags": [
    "tamagotchi-go"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(probe_success, service)",
          "refId": "service"
        },
        "definition": "label_values(probe_success, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(machine)",
        "definition": "label_values(machine)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "debug,info,warn,warning,error",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Services",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replicas up",
      "description": "Replicas answering their health check, per service, on every machine (from Service Discovery). A stopped replica drops out within 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (probe_success{service=~\"$service\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Answered HTTP requests per service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (rate(http_requests_total{job=~\"$service\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors per second (5xx)",
      "description": "Answers with a 5xx status, per service and status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, status) (rate(http_requests_total{job=~\"$service\", status=~\"5..\"}[1m]))",
          "legendFormat": "{{job}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 5
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "95th percentile answer time per service, over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Client errors per second (4xx)",
      "description": "Answers with a 4xx status, per service and status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, status) (rate(http_requests_total{job=~\"$service\", status=~\"4..\"}[1m]))",
          "legendFormat": "{{job}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 13
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Load per instance",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per second per replica",
      "description": "How the load spreads over the replicas of each service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance) (rate(http_requests_total{job=~\"$service\"}[1m]))",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "In-flight requests per replica",
      "description": "Requests being handled right now, per replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance) (http_requests_in_flight{job=~\"$service\"})",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 22
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Circuit breakers",
      "description": "Per calling service and called service: 0 closed, 1 half-open, 2 open.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job, target) (circuit_breaker_state{job=~\"$service\"})",
          "legendFormat": "{{job}} → {{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Health (every replica, every machine)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 38
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Replicas down",
      "description": "Replicas Service Discovery lists whose health check fails right now. Empty is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{service=~\"$service\"} == 0",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 39
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Health check time",
      "description": "How long each service takes to answer its health check (slowest replica).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (probe_duration_seconds{service=~\"$service\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 39
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Message Broker",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 47
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Request queue length",
      "description": "Requests waiting on each service's queue in the broker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (target) (broker_request_queue_length)",
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 48
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Event queue length",
      "description": "Event copies waiting on each topic queue, per subscriber, and copies not yet acked per topic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic, subscriber) (broker_event_queue_length)",
          "legendFormat": "{{topic}} → {{subscriber}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (broker_events_pending)",
          "legendFormat": "{{topic}} pending"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 48
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Requests through the broker",
      "description": "Requests on service queues per second, by target and reply status (503/504/502 included).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (target, status) (rate(broker_requests_total[1m]))",
          "legendFormat": "{{target}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 56
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Event copies by outcome",
      "description": "Copies delivered, acked, retried and dropped per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(broker_events_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 56
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Dead Letter Channel size",
      "description": "Event copies dropped after every delivery attempt failed, since the broker started.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(broker_events_total{outcome=\"dropped\"}) or vector(0)",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 64
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Events published",
      "description": "Events accepted per topic and publisher, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic, source) (rate(broker_events_published_total[1m]))",
          "legendFormat": "{{topic}} ({{source}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "gridPos": {
        "w": 16,
        "h": 8,
        "x": 8,
        "y": 64
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 72
      }
    },
    {
      "id": 22,
      "type": "logs",
      "title": "Logs",
      "description": "Every container's log lines from Loki. Filter with the service and level variables, or search for a requestId.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\", machine=~\"$machine\", level=~\"$level\"} |~ \"$search\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "gridPos": {
        "w": 24,
        "h": 14,
        "x": 0,
        "y": 73
      }
    }
  ]
}
