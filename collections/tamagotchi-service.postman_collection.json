    {
      "name": "Setup: a package with stat definitions (Package Registry directly)",
      "item": [
        {
          "name": "Register a package (as the seeded admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('packageId', pm.response.json().packageId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Gateway-Key",
                "value": "{{gatewayKey}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{packageAdminId}}"
              }
            ],
            "url": {
              "raw": "{{packageRegistryUrl}}/packages",
              "host": [
                "{{packageRegistryUrl}}"
              ],
              "path": [
                "packages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tamagotchi collection {{runId}}\",\n  \"version\": \"1.0.{{runId}}\",\n  \"description\": \"Created by the tamagotchi-service collection\",\n  \"moderatorIds\": [\n    \"{{packageAdminId}}\"\n  ]\n}"
            },
            "description": "Plays the gateway (X-Gateway-Key + X-User-Id), because the seeded admin is not a user anyone can log in as."
          },
          "response": []
        },
        {
          "name": "Define its stats: hunger and happiness",
