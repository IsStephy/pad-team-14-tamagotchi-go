    {
      "name": "Register an instance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('returns the instance id and the heartbeat timing', () => {",
              "    pm.expect(body.instanceId).to.be.a('string').and.not.empty;",
              "    pm.expect(body.heartbeatIntervalSeconds).to.eql(10);",
              "    pm.expect(body.ttlSeconds).to.eql(30);",
              "});",
              "pm.collectionVariables.set('instanceId', body.instanceId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Discovery-Key",
            "value": "{{discoveryKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{discoveryUrl}}/services/register",
          "host": [
            "{{discoveryUrl}}"
          ],
          "path": [
            "services",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service\": \"{{probeService}}\",\n  \"url\": \"http://localhost:8089\"\n}"
        },
        "description": "What every replica does once it is listening. The address here is Service Discovery itself, so its health checks find this test instance healthy and raise no alert."
      },
      "response": []
    },
