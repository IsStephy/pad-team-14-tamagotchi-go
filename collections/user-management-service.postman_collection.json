        {
          "name": "Battle ended, published on the broker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Broker-Key",
                "value": "{{brokerKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/topics/battle.ended/messages",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "topics",
                "battle.ended",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"battle-service\",\n  \"messageId\": \"{{battleMessageId}}\",\n  \"payload\": {\n    \"battleId\": \"{{battleId}}\",\n    \"winnerId\": \"{{userId}}\",\n    \"loserId\": \"{{targetUserId}}\",\n    \"rewardCurrency\": 25,\n    \"rewardXp\": 0,\n    \"transferredTamagotchiId\": \"\",\n    \"loserCurrencyPenalty\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One battle and one messageId for this run; the next request sends the same event again.",
                  "pm.collectionVariables.set('battleId', 'postman-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('battleMessageId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "pm.test('User Management subscribes to battle.ended', function () { pm.expect(pm.response.json().subscribers).to.include('user-management-service'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "The same event again, same messageId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Broker-Key",
                "value": "{{brokerKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/topics/battle.ended/messages",
