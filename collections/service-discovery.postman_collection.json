{
  "info": {
    "_postman_id": "945f3ced-bffc-40f6-823b-039c35658579",
    "name": "Service Discovery (Team 14)",
    "description": "The registry of running service instances (Lab 3).\n\nOwner: Dackohn. Port: 8089, called directly: it is infrastructure, not behind the gateway.\n\nSet `discoveryKey` to `DISCOVERY_KEY` from your `.env` before running. The collection registers one test instance under its own service name, heartbeats, deregisters it, then lists the Map and Monster Raid replicas of the shared stack.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health (public)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Each run uses its own service name, so runs never see each other's instance.",
              "pm.collectionVariables.set('probeService', 'postman-probe-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK without a key', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('reports itself and its load', () => {",
              "    pm.expect(body.status).to.eql('ok');",
              "    pm.expect(body.service).to.eql('service-discovery');",
              "    pm.expect(body.instanceId).to.be.a('string').and.not.empty;",
              "    pm.expect(body.inFlightRequests).to.be.a('number');",
              "    pm.expect(body.maxConcurrentRequests).to.be.a('number');",
              "});",
              "pm.test('summarises the health checks', () => pm.expect(body.healthChecks).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{discoveryUrl}}/health",
          "host": [
            "{{discoveryUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Status endpoint: public, outside the limits. Also shows how many services and instances are registered and the state of the health checks."
      },
      "response": []
    },
    {
      "name": "Health checks are running",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const checks = pm.response.json().healthChecks;",
              "pm.test('checks every instance at an interval', () => {",
              "    pm.expect(checks.intervalSeconds).to.be.a('number').and.above(0);",
              "    pm.expect(checks.rounds).to.be.at.least(1);",
              "    pm.expect(checks.instancesWatched).to.be.at.least(1);",
              "});",
              "pm.test('lists the instances alerting right now', () => pm.expect(checks.alerting).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{discoveryUrl}}/health",
          "host": [
            "{{discoveryUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Lab 3 Grade 8: Service Discovery calls every registered instance's /health every intervalSeconds and alerts on critical load, no answer or not ok. `alerting` lists the open alerts."
      },
      "response": []
    },
    {
      "name": "Send a test alert to Telegram (only when sendTestAlert is true)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('sendTestAlert') !== 'true') {",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('sendTestAlert') !== 'true') { return; }",
              "pm.test('Telegram accepted the test message', () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().sent).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Discovery-Key",
            "value": "{{discoveryKey}}"
          }
        ],
        "url": {
          "raw": "{{discoveryUrl}}/alerts/test",
          "host": [
            "{{discoveryUrl}}"
          ],
          "path": [
            "alerts",
            "test"
          ]
        },
        "description": "Lab 3 Grade 9: posts a real test message to the team's Telegram alerts topic, so it is skipped unless the collection variable `sendTestAlert` is `true`. Answers 409 when Telegram is not configured (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID empty)."
      },
      "response": []
    },
