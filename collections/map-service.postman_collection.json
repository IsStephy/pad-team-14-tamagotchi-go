        {
          "name": "Alice sees her friend, her enemy and a stranger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const byUser = Object.fromEntries(pm.response.json().map(u => [u.userId, u.relationship]));",
                  "pm.test('Bob is a friend', function () { pm.expect(byUser[pm.collectionVariables.get('bobId')]).to.eql('friend'); });",
                  "pm.test('Carol is an enemy', function () { pm.expect(byUser[pm.collectionVariables.get('carolId')]).to.eql('enemy'); });",
                  "pm.test('Dave is a stranger', function () { pm.expect(byUser[pm.collectionVariables.get('daveId')]).to.eql('none'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
