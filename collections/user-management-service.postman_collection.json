        {
          "name": "The winner was paid once",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/users/{{userId}}/currency",
