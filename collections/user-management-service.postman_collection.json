              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Through the Message Broker",
      "description": "Other services reach User Management through the broker: X-Broker-Key plus the caller's own X-Service-Key, and each key opens only the endpoints that list its service (CPR README, Access per endpoint). Events from battle.ended are paid at POST /events, each messageId once.",
      "item": [
        {
          "name": "Guild reads a user through the broker",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Broker-Key",
                "value": "{{brokerKey}}"
              },
              {
                "key": "X-Service-Key",
                "value": "{{guildServiceKey}}"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/services/user-management-service/users/{{userId}}",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "services",
                "user-management-service",
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('the user asked for', function () { pm.expect(pm.response.json().userId).to.eql(pm.collectionVariables.get('userId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Map may not adjust currency (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Broker-Key",
                "value": "{{brokerKey}}"
              },
              {
                "key": "X-Service-Key",
                "value": "{{mapServiceKey}}"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/services/user-management-service/users/{{userId}}/currency/adjust",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "services",
                "user-management-service",
                "users",
                "{{userId}}",
                "currency",
                "adjust"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"globalCurrencyDelta\": 1000,\n  \"reason\": \"free money\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });",
                  "pm.test('names the reason, not the key', function () { pm.expect(pm.response.json().error).to.eql('this service may not call this endpoint'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "The broker key alone is not enough (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Broker-Key",
                "value": "{{brokerKey}}"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/services/user-management-service/users/{{userId}}",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "services",
                "user-management-service",
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
