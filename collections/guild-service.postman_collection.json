{
  "info": {
    "name": "Guild Service (Team 14)",
    "description": "Guild identity, membership, roles and real-time guild chat.\n\nOwner: IsStephy. Default port: 8087.\n\nEvery endpoint except /health and /docs needs a user token, sent as `Authorization: Bearer <token>`. Identity is the token's `sub` claim, and guild roles are checked by this service against its own data, per the CPR's authentication contract.\n\nRun the requests top to bottom: `Get Dev Token` mints a token, and `Create Guild` saves the new guildId - so every later request works without copy-pasting anything.\n\nThe WebSocket chat endpoint cannot be stored in Postman's collection file format; see the `Guild Chat (WebSocket)` folder for how to add it in the app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "guildId",
      "value": ""
    },
    {
      "key": "ownerId",
      "value": "u-owner-1"
    },
    {
      "key": "memberId",
      "value": "u-member-2"
    },
    {
      "key": "inviteeId",
      "value": "u-member-3"
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "inviteeToken",
      "value": ""
    },
    {
      "key": "unknownUserId",
      "value": "unknown-user-99"
    },
    {
      "key": "unknownToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness check. Returns { status: ok, service: guild-service }."
      },
      "response": []
    },
    {
      "name": "Get Dev Token (owner)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('ownerToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{ownerId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/dev/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dev",
            "token"
          ]
        },
        "description": "Mints a user token for testing. This endpoint exists only while USER_MANAGEMENT_URL is unset - it stands in for User Management's POST /users/login, which will issue the real RS256 token. The service verifies tokens the same way either way.\n\nRun this FIRST: every other request sends the token as Authorization: Bearer."
      },
      "response": []
    },
    {
      "name": "Get Dev Token (member)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('memberToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{memberId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/dev/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "dev",
            "token"
          ]
        },
        "description": "A second player, so self-join and membership rules can be exercised."
      },
      "response": []
    },
