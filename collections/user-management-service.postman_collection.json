    },
    {
      "name": "Get user without a token (rejected by the gateway)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/users/{{userId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"the gateway refuses it before any service sees it\", function () {",
              "    pm.expect(pm.response.json().error).to.match(/bearer token/i);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/users/{{userId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Reads the profile other services resolve identity against."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"is the account we registered\", function () {",
              "    pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"username1\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/users/{{userId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Partial update: omitted fields are left untouched.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profile\": \"Gym leader in training\",\n  \"level\": 7\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"applies the supplied fields\", function () {",
              "    pm.expect(body.profile).to.eql(\"Gym leader in training\");",
              "    pm.expect(body.level).to.eql(7);",
              "});",
              "pm.test(\"leaves untouched fields alone\", function () {",
              "    pm.expect(body.username).to.eql(pm.collectionVariables.get(\"username1\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get currency",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/users/{{userId}}/currency",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "currency"
          ]
        },
        "description": "Both balances. A fresh account starts at zero."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"a new account starts empty\", function () {",
              "    pm.expect(body.localCurrency).to.eql(0);",
              "    pm.expect(body.globalCurrency).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Adjust currency (credit a battle reward) through the broker",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Service-Key",
            "value": "{{battleServiceKey}}"
          },
          {
            "key": "X-Broker-Key",
            "value": "{{brokerKey}}"
          }
        ],
        "url": {
          "raw": "{{brokerUrl}}/services/user-management-service/users/{{userId}}/currency/adjust",
          "host": [
            "{{brokerUrl}}"
          ],
          "path": [
            "services",
            "user-management-service",
            "users",
            "{{userId}}",
            "currency",
            "adjust"
          ]
        },
        "description": "Deltas may be positive or negative. The balance change and its ledger entry are written in one transaction. Service-only: Battle calls it through the Message Broker with X-Broker-Key and its own X-Service-Key; the gateway answers it with 404 from v4.0.0.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"globalCurrencyDelta\": 250,\n  \"localCurrencyDelta\": 10,\n  \"reason\": \"battle reward\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"returns the resulting balance\", function () {",
              "    pm.expect(body.globalCurrency).to.eql(250);",
              "    pm.expect(body.localCurrency).to.eql(10);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Adjust currency beyond the balance through the broker (rejected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Service-Key",
            "value": "{{battleServiceKey}}"
          },
          {
            "key": "X-Broker-Key",
            "value": "{{brokerKey}}"
          }
        ],
        "url": {
          "raw": "{{brokerUrl}}/services/user-management-service/users/{{userId}}/currency/adjust",
          "host": [
            "{{brokerUrl}}"
          ],
          "path": [
            "services",
            "user-management-service",
            "users",
            "{{userId}}",
            "currency",
            "adjust"
          ]
        },
        "description": "An adjustment that would overdraw is refused and leaves the balance untouched. Service-only: Battle calls it through the Message Broker with X-Broker-Key and its own X-Service-Key; the gateway answers it with 404 from v4.0.0.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"globalCurrencyDelta\": -9999,\n  \"reason\": \"battle loss\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Balance survived the rejected adjustment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/users/{{userId}}/currency",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "currency"
          ]
        },
        "description": "Confirms the refused adjustment above changed nothing."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
