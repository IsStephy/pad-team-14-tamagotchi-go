{
  "info": {
    "name": "User Management Service (Team 14)",
    "description": "Every endpoint of the User Management Service, in an order that runs top to bottom as a complete scenario: two players register, become friends, earn currency, fall out, and are deleted again.\n\nStart the service first with `./run.sh` in the user-management-service repo, then hit Run to verify it works. `baseUrl` defaults to http://localhost:8081.\n\nIds and the login token are captured into collection variables as the run progresses, so nothing needs to be filled in by hand. Usernames are generated per run, so the collection can be run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "packageId",
      "value": "pkg-demo",
      "type": "string"
    },
    {
      "key": "password",
      "value": "correct-horse-battery",
      "type": "string"
    },
    {
      "key": "username1",
      "value": "",
      "type": "string"
    },
    {
      "key": "username2",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "missingId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness probe. Answers as soon as the service is up and migrated."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"reports this service\", function () {",
              "    pm.expect(pm.response.json().service).to.eql(\"user-management-service\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register player one",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "register"
          ]
        },
        "description": "Creates an account. The username is generated per run so the collection can be re-run.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username1}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username1}}@tamagotchi.go\",\n  \"packageId\": \"{{packageId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-9);",
              "pm.collectionVariables.set(\"username1\", \"trainer_\" + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"returns the new user id\", function () {",
              "    pm.expect(body.userId).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.test(\"never echoes the password\", function () {",
              "    pm.expect(body).to.not.have.property(\"password\");",
              "});",
              "pm.collectionVariables.set(\"userId\", body.userId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register player two",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "register"
          ]
        },
        "description": "A second account, so the friend/enemy endpoints have someone to point at.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username2}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username2}}@tamagotchi.go\",\n  \"packageId\": \"{{packageId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-9);",
              "pm.collectionVariables.set(\"username2\", \"rival_\" + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"targetUserId\", pm.response.json().userId);"
            ]
          }
        }
      ]
    },
    {
