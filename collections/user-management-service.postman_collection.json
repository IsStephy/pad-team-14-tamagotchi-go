          ],
          "path": [
            "users",
            "{{userId}}",
            "currency",
            "adjust"
          ]
        },
        "description": "Deltas may be positive or negative. The balance change and its ledger entry are written in one transaction.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"globalCurrencyDelta\": 250,\n  \"localCurrencyDelta\": 10,\n  \"reason\": \"battle reward\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
