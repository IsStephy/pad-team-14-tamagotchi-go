    {
      "name": "Update profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Partial update: omitted fields are left untouched.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profile\": \"Gym leader in training\",\n  \"level\": 7\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"applies the supplied fields\", function () {",
              "    pm.expect(body.profile).to.eql(\"Gym leader in training\");",
              "    pm.expect(body.level).to.eql(7);",
              "});",
              "pm.test(\"leaves untouched fields alone\", function () {",
              "    pm.expect(body.username).to.eql(pm.collectionVariables.get(\"username1\"));",
              "});"
            ]
          }
        }
      ]
    },
