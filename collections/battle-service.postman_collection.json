        "description": "Ends the match immediately, handing the win to the opponent. The settlement in `result` is the BattleEnded payload other services will consume once async messaging is wired up.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{player1Id}}\",\n  \"action\": \"forfeit\"\n}",
