    {
      "name": "Guild chat (WebSocket negotiation)",
      "item": [
        {
          "name": "Negotiate the chat socket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('a direct ws:// URL to the chat, carrying a ticket', function () {",
                  "    pm.expect(body.wsUrl).to.match(/^wss?:\\/\\//);",
                  "    pm.expect(body.wsUrl).to.include('/guilds/' + pm.collectionVariables.get('guildId') + '/chat');",
                  "    pm.expect(body.wsUrl).to.include('ticket=');",
                  "});",
                  "pm.test('the player token is not in the URL', function () {",
                  "    pm.expect(body.wsUrl).to.not.include(pm.collectionVariables.get('ownerToken'));",
                  "});",
                  "pm.collectionVariables.set('chatUrl', body.wsUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/ws/negotiate?path=/guilds/{{guildId}}/chat",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "ws",
                "negotiate"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "/guilds/{{guildId}}/chat"
                }
              ]
            },
            "description": "The gateway checks the token and returns guild-service's own WebSocket URL with a single-use ticket (valid 60 s). Open {{chatUrl}} in a Postman WebSocket tab and send {\"authorId\": \"<ownerId>\", \"message\": \"hi\"}: the socket goes to guild-service directly, not through the gateway. A ticket opens one socket only - negotiate again for another."
          },
          "response": []
        },
        {
          "name": "Negotiate without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/ws/negotiate?path=/guilds/{{guildId}}/chat",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "ws",
                "negotiate"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "/guilds/{{guildId}}/chat"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Chat over plain HTTP is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });",
                  "pm.test('error mentions \"/ws/negotiate\"', function () { pm.expect(pm.response.json().error).to.include('/ws/negotiate'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/guilds/{{guildId}}/chat",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "guilds",
                "{{guildId}}",
                "chat"
              ]
            },
            "description": "The gateway never relays the socket; it points the caller at /ws/negotiate."
          },
          "response": []
        }
      ]
    },
