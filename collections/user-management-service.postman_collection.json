          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username1}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"someone-else@tamagotchi.go\",\n  \"packageId\": \"{{packageId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Log in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "login"
          ]
        },
        "description": "Exchanges credentials for a signed token.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username1}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"returns a token for this user\", function () {",
              "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.userId).to.eql(pm.collectionVariables.get(\"userId\"));",
              "});",
              "pm.collectionVariables.set(\"token\", body.token);"
            ]
          }
        }
      ]
    },
