    {
      "name": "tamagotchi-service is up behind the gateway",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Every run starts here with a new runId, so each run registers new players.",
              "pm.collectionVariables.set('runId', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('tamagotchi-service is ok', function () { pm.expect(pm.response.json().services['tamagotchi-service'].status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/health/services",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "health",
            "services"
          ]
        }
      },
      "response": []
    },
