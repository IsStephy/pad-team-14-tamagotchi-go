              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{playerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Invalid token - stopped at the gateway (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{invalidToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{playerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Registering a device for someone else (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });",
                  "pm.test('error: userId must be the caller', function () { pm.expect(pm.response.json().error).to.eql(\"userId must be the caller\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/register-device",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "register-device"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{playerId}}\",\n  \"fcmToken\": \"stolen-{{runId}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Reading someone else's notifications (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });",
                  "pm.test('error: userId must be the caller', function () { pm.expect(pm.response.json().error).to.eql(\"userId must be the caller\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{playerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Forged X-User-Id is ignored (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{playerId}}"
              },
              {
                "key": "X-Gateway-Key",
                "value": "guessed-key"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{playerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            },
            "description": "The other player claims to be the player through forged headers. The gateway drops them and sets its own, so Notification still sees the other player."
          },
          "response": []
        },
        {
          "name": "An unknown notification (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/00000000-0000-0000-0000-000000000000/read",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "00000000-0000-0000-0000-000000000000",
                "read"
              ]
            }
          },
          "response": []
        },
        {
          "name": "A service key instead of a player (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('error: invalid service key', function () { pm.expect(pm.response.json().error).to.eql(\"invalid service key\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Key",
                "value": "any-key"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{playerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            },
            "description": "Notification has no service-to-service endpoints, so any X-Service-Key is refused."
          },
          "response": []
        },
        {
          "name": "Notification without the gateway (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('error: missing or invalid gateway key', function () { pm.expect(pm.response.json().error).to.eql(\"missing or invalid gateway key\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{playerId}}"
              }
            ],
            "url": {
              "raw": "{{notificationUrl}}/notifications/{{playerId}}",
              "host": [
                "{{notificationUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            },
            "description": "Straight to Notification's own port: refused, because only the gateway holds GATEWAY_KEY."
          },
          "response": []
        }
      ]
    }
  ]
}
