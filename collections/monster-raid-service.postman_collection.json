          "name": "Through the broker: Guild and User Management over gRPC, Tamagotchi over REST, raid.completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const count = (name, labels) => pm.response.text().split('\\n').filter(l => l.startsWith(name + '{') && labels.every(x => l.includes(x))).reduce((sum, l) => sum + Number(l.split(' ').pop()), 0);",
                  "pm.test('membership was checked with GetGuild over gRPC', function () {",
                  "  pm.expect(count('broker_grpc_calls_total', ['target=\"guild-service\"', 'method=\"GetGuild\"', 'code=\"OK\"'])).to.be.above(Number(pm.collectionVariables.get('guildCalls')));",
                  "});",
                  "pm.test('the reward was paid with AdjustCurrency over gRPC', function () {",
                  "  pm.expect(count('broker_grpc_calls_total', ['target=\"user-management-service\"', 'method=\"AdjustCurrency\"'])).to.be.above(Number(pm.collectionVariables.get('rewardCalls')));",
                  "});",
                  "pm.test('the Tamagotchi was read through the broker', function () {",
                  "  pm.expect(count('broker_requests_total', ['target=\"tamagotchi-service\"'])).to.be.above(Number(pm.collectionVariables.get('tamagotchiRequests')));",
                  "});",
                  "pm.test('raid.completed was published on the broker', function () {",
                  "  pm.expect(count('broker_events_published_total', ['topic=\"raid.completed\"', 'source=\"monster-raid-service\"'])).to.be.above(Number(pm.collectionVariables.get('raidEvents')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{brokerUrl}}/metrics",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Every call Monster Raid made for this raid went through the broker: GetGuild (membership) and AdjustCurrency (the reward) at message-broker:50051, the Tamagotchi over REST at /services/tamagotchi-service, and raid.completed on its topic."
          },
          "response": []
        }
