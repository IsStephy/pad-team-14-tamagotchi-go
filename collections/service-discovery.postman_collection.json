    {
      "name": "Map Service replicas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('lists map-service', () => pm.expect(body.service).to.eql('map-service'));",
              "pm.test('at least one replica is registered', () => pm.expect(body.instances).to.be.an('array').that.is.not.empty);",
              "pm.test('each replica registered its own base address (any port: extra replicas use the port range of their service port range)', () => {",
              "    body.instances.forEach((i) => {",
              "        pm.expect(i.url).to.match(/^https?:\\/\\/[^/:]+(:\\d+)?$/);",
              "        pm.expect(i.instanceId).to.be.a('string').and.not.empty;",
              "    });",
              "    const urls = body.instances.map((i) => i.url);",
              "    pm.expect(new Set(urls).size).to.eql(urls.length);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Discovery-Key",
            "value": "{{discoveryKey}}"
