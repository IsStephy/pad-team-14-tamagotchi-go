            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"battle-service\",\n  \"messageId\": \"{{battleMessageId}}\",\n  \"payload\": {\n    \"battleId\": \"{{battleId}}\",\n    \"winnerId\": \"{{userId}}\",\n    \"loserId\": \"{{targetUserId}}\",\n    \"rewardCurrency\": 25,\n    \"rewardXp\": 0,\n    \"transferredTamagotchiId\": \"\",\n    \"loserCurrencyPenalty\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
