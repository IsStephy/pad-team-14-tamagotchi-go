      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "notification-service is up behind the gateway",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Every run starts here with a new runId, so each run registers new players.",
              "pm.collectionVariables.set('runId', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('notification-service is ok', function () { pm.expect(pm.response.json().services['notification-service'].status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/health/services",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "health",
            "services"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Players (User Management, through the gateway)",
      "item": [
        {
          "name": "Register (player)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/users/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player-{{runId}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"player-{{runId}}@example.com\",\n  \"packageId\": \"p1\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Log in (player)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('playerToken', body.token);",
                  "pm.collectionVariables.set('playerId', body.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/users/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player-{{runId}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Register (other)",
          "event": [
            {
