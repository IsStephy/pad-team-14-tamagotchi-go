            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"the battle is finished\", function () {",
              "    pm.expect(body.status).to.eql(\"finished\");",
              "    pm.expect(body.currentTurn).to.eql(\"\");",
              "});",
              "pm.test(\"player two wins\", function () {",
              "    pm.expect(body.result.winnerId).to.eql(pm.collectionVariables.get(\"player2Id\"));",
              "    pm.expect(body.result.loserId).to.eql(pm.collectionVariables.get(\"player1Id\"));",
              "});",
              "pm.test(\"the loser's primary Tamagotchi changes hands\", function () {",
              "    pm.expect(body.result.transferredTamagotchiId)",
              "        .to.eql(pm.collectionVariables.get(\"primaryTamagotchiId\"));",
              "});",
              "pm.test(\"xp splits 60/40 and adds back up\", function () {",
              "    pm.expect(body.result.primaryXp + body.result.secondaryXp)",
              "        .to.eql(body.result.rewardXp);",
              "});"
            ]
          }
        }
      ]
    },
