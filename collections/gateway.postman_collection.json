    {
      "name": "Authorization at the gateway",
      "item": [
        {
          "name": "No token - stopped at the gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('error mentions \"missing bearer token\"', function () { pm.expect(pm.response.json().error).to.include('missing bearer token'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/guilds/search?query=owls",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "guilds",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "owls"
                }
              ]
            },
            "description": "The gateway rejects the request itself; it never reaches Guild Service."
          },
          "response": []
        },
        {
          "name": "Invalid token - stopped at the gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('error mentions \"invalid token\"', function () { pm.expect(pm.response.json().error).to.include('invalid token'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not.a.real.token"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/guilds/search?query=owls",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "guilds",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "owls"
                }
              ]
            },
            "description": "A token that does not verify against User Management's keys."
          },
          "response": []
        },
        {
          "name": "Forged X-User-Id is ignored",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });",
                  "pm.test('the service saw the real caller (the member), not the forged owner', function () {",
                  "    pm.expect(pm.response.json().error).to.include(pm.collectionVariables.get('memberId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              },
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Gateway-Key",
                "value": "guessed-key"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/guilds",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "guilds"
              ]
            },
            "description": "The member sends their own token plus forged identity headers claiming to be the owner. The gateway drops client-sent X-User-Id / X-Gateway-Key and sets its own, so Guild Service sees the member and refuses to create a guild owned by someone else.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Forged {{runId}}\",\n  \"ownerId\": \"{{ownerId}}\"\n}"
            }
          },
          "response": []
        }
      ]
    },
