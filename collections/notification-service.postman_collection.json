              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/users/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"other-{{runId}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"other-{{runId}}@example.com\",\n  \"packageId\": \"p1\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Log in (other)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('otherToken', body.token);",
                  "pm.collectionVariables.set('otherId', body.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
