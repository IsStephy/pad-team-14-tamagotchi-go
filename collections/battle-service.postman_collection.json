    {
      "name": "Attack (player one)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/battles/{{battleId}}/action",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "battles",
            "{{battleId}}",
            "action"
          ]
        },
        "description": "Deals damage from levels, the type matchup and equipped boosts, then passes the turn.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{player1Id}}\",\n  \"action\": \"attack\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"damages the opponent\", function () {",
              "    pm.expect(body.healthP2).to.be.below(body.player2.maxHealth);",
              "});",
              "pm.test(\"passes the turn to player two\", function () {",
              "    pm.expect(body.currentTurn).to.eql(pm.collectionVariables.get(\"player2Id\"));",
              "    pm.expect(body.turnNumber).to.eql(2);",
              "});",
              "pm.test(\"records the move in the log\", function () {",
              "    pm.expect(body.log).to.have.lengthOf(1);",
              "    pm.expect(body.log[0].action).to.eql(\"attack\");",
              "    pm.expect(body.log[0].damage).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
