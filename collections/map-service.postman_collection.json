              ],
              "path": [
                "map",
                "nearby",
                "{{aliceId}}"
              ]
            },
            "description": "Map asks User Management for each relationship, through the gateway, with its own service key."
          },
          "response": []
        },
        {
          "name": "Negotiate the location stream",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const wsUrl = pm.response.json().wsUrl;",
                  "pm.test('a direct URL to Map with a one-time ticket', function () { pm.expect(wsUrl).to.match(/\\/map\\/stream\\?ticket=/); });",
                  "pm.collectionVariables.set('wsUrl', wsUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/ws/negotiate?path=/map/stream",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "ws",
                "negotiate"
              ],
              "query": [
                {
                  "key": "path",
                  "value": "/map/stream"
                }
              ]
            },
            "description": "The gateway checks the token and answers with Map's own socket URL plus a one-time ticket. See the WebSocket folder."
          },
          "response": []
        }
      ]
    },
