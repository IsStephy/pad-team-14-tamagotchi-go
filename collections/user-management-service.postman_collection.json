{
  "info": {
    "name": "User Management Service (Team 14)",
    "description": "Every endpoint of the User Management Service, reached through the gateway, in an order that runs top to bottom as a complete scenario: two players register and log in, become friends, earn currency, fall out, and are deleted again.\n\nStart the whole system first (`docker compose up -d` in the CPR), then hit Run. Requests go to `{{gatewayUrl}}` (default `http://localhost:8080`) with each player's own token. Currency adjustment is service-only, so it carries Battle's key instead: set `battleServiceKey` to `SERVICE_KEY_BATTLE` from your `.env`, e.g. `npx newman run user-management-service.postman_collection.json --env-var battleServiceKey=<key>`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "battleServiceKey",
      "value": "change_me"
    },
    {
      "key": "packageId",
      "value": "pkg-demo",
      "type": "string"
    },
    {
      "key": "password",
      "value": "correct-horse-battery",
      "type": "string"
    },
    {
      "key": "username1",
      "value": "",
      "type": "string"
    },
    {
      "key": "username2",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "missingId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "brokerUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "brokerKey",
      "value": "change_me"
    },
    {
      "key": "guildServiceKey",
      "value": "change_me"
    },
    {
      "key": "mapServiceKey",
      "value": "change_me"
    },
    {
      "key": "battleId",
      "value": ""
    },
    {
      "key": "battleMessageId",
      "value": ""
