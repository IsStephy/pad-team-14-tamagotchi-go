# Shared stack configuration for Tamagotchi Go (Team 14).
#
# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is git-ignored and must never be committed. This file holds
# PLACEHOLDERS ONLY — never paste a real password or secret here.
#
# Variables are prefixed with the service they belong to, so entries from
# different services can't collide. Add yours in the same style.

# ---- User Management Service (Go) ------------------------------------------
USER_MANAGEMENT_PORT=8081
USER_MANAGEMENT_DB_NAME=user_management_db
USER_MANAGEMENT_DB_USER=user_management_user
USER_MANAGEMENT_DB_PASSWORD=change_me
USER_MANAGEMENT_JWT_TTL=24h
# RS256 private key (PEM, newlines as \n). Leave empty and one is generated on
# first start and kept in the service's own database.
USER_MANAGEMENT_JWT_PRIVATE_KEY=

# ---- Access rules (shared) -------------------------------------------------
# Turn on the contract's per-endpoint access rules. Leave false until every
# service sends credentials; flipping it early breaks the callers that don't.
AUTH_ENFORCED=false

# ---- Battle Service (Go) ---------------------------------------------------
BATTLE_PORT=8082
BATTLE_DB_NAME=battle_db
BATTLE_DB_USER=battle_user
BATTLE_DB_PASSWORD=change_me
# Where Battle's calls to other services go. Empty = through the gateway,
# http://gateway:8080: service-to-service calls go through it too.
BATTLE_USER_MANAGEMENT_URL=
BATTLE_TAMAGOTCHI_SERVICE_URL=
BATTLE_PACKAGE_REGISTRY_URL=

# ---- Tamagotchi Service (Go) -----------------------------------------------
TAMAGOTCHI_PORT=8083
TAMAGOTCHI_DB_NAME=tamagotchi_db
TAMAGOTCHI_DB_USER=tamagotchi_user
# Embedded in a postgres:// URL — URL-safe characters only. openssl rand -hex 16
TAMAGOTCHI_DB_PASSWORD=change_me

# ---- Notification Service (Go) ---------------------------------------------
NOTIFICATION_PORT=8084
# Embedded in a redis:// URL — URL-safe characters only. openssl rand -hex 16
NOTIFICATION_REDIS_PASSWORD=change_me

# ---- Map Service -----------------------------------------------------------
MAP_PORT=8085
# Embedded in a redis:// URL — URL-safe characters only. openssl rand -hex 16
MAP_REDIS_PASSWORD=change_me
# Empty = built-in mock of User Management (fixed test data) and test tokens
# via POST /auth/mock-token. Set it to verify real RS256 tokens against
# User Management's JWKS.
MAP_USER_MANAGEMENT_URL=

# ---- Monster Raid Service --------------------------------------------------
MONSTER_RAID_PORT=8086
MONSTER_RAID_DB_NAME=monster_raid_db
MONSTER_RAID_DB_USER=monster_raid_user
# Passwords are embedded in connection URLs — URL-safe characters only.
MONSTER_RAID_DB_PASSWORD=change_me
MONSTER_RAID_REDIS_PASSWORD=change_me
# Empty = built-in mocks (fixed test data); set a base URL for the real service.
MONSTER_RAID_GUILD_SERVICE_URL=
MONSTER_RAID_TAMAGOTCHI_SERVICE_URL=
# Empty also means test tokens via POST /auth/mock-token.
MONSTER_RAID_USER_MANAGEMENT_URL=
# POST /raids only accepts Package Registry's key:
# PACKAGE_REGISTRY_MONSTER_RAID_SERVICE_KEY below.

# ---- Guild Service ----
GUILD_PORT=8087
GUILD_DB_NAME=guild_db
GUILD_DB_USER=guild_user
GUILD_DB_PASSWORD=change_me
# Task timeout and concurrent task limits (defaults shown).
GUILD_REQUEST_TIMEOUT_MS=8000
GUILD_MAX_CONCURRENT_REQUESTS=40
GUILD_MAX_WS_CONNECTIONS=500

# ---- Package Registry Service ----
PACKAGE_REGISTRY_PORT=8088
PACKAGE_REGISTRY_DB_NAME=package_registry_db
PACKAGE_REGISTRY_DB_USER=package_registry_user
PACKAGE_REGISTRY_DB_PASSWORD=change_me
# POST /admins itself needs an admin, so the first one is seeded from here.
PACKAGE_REGISTRY_INITIAL_ADMIN_USER_ID=admin-1
# Where POST /raids goes. Empty = through the gateway, http://gateway:8080:
# service-to-service calls go through it too.
PACKAGE_REGISTRY_MONSTER_RAID_URL=
PACKAGE_REGISTRY_MONSTER_RAID_SERVICE_KEY=change_me
# Task timeout and concurrent task limit (defaults shown).
# MONSTER_RAID_TIMEOUT_MS must be lower than REQUEST_TIMEOUT_MS.
PACKAGE_REGISTRY_REQUEST_TIMEOUT_MS=8000
PACKAGE_REGISTRY_MONSTER_RAID_TIMEOUT_MS=5000
PACKAGE_REGISTRY_MAX_CONCURRENT_REQUESTS=40

# ---- Service keys -----------------------------------------------------------
# Services calling each other's internal endpoints send their own key as
# X-Service-Key (through the gateway, which adds its own key as well). Each
# value is set once here and read by both the caller and the callee.
#   Battle       -> User Management (currency adjust),
#                   Tamagotchi (xp, transfer-owner)
#   Monster Raid -> User Management (currency adjust), Guild (GET /guilds/{id}),
#                   Tamagotchi (GET /tamagotchis/{id})
#   Map          -> User Management (relationship)
# Generate each with: openssl rand -hex 32
SERVICE_KEY_BATTLE=change_me
SERVICE_KEY_MONSTER_RAID=change_me
SERVICE_KEY_MAP=change_me

# ---- Gateway (Python) ------------------------------------------------------
# The single entry point. Clients and services call it instead of each other.
GATEWAY_PORT=8080
# Shared secret the gateway sends as X-Gateway-Key. Every service that sits
# behind the gateway gets the SAME value and trusts X-User-Id only with it.
# Generate one with: openssl rand -hex 32
GATEWAY_KEY=change_me
# gateway = verify tokens here and strip Authorization (the graded setup).
# passthrough = forward Authorization untouched - a migration aid only.
GATEWAY_AUTH_MODE=gateway
# Task timeout and concurrent task limits (defaults shown).
GATEWAY_REQUEST_TIMEOUT_SECONDS=10
GATEWAY_MAX_CONCURRENT_REQUESTS=100
GATEWAY_MAX_CONCURRENT_PER_SERVICE=50
