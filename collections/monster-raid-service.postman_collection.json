    {
      "name": "Monster Raid through the gateway",
      "item": [
        {
          "name": "Broker counters before",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const count = (name, labels) => pm.response.text().split('\\n').filter(l => l.startsWith(name + '{') && labels.every(x => l.includes(x))).reduce((sum, l) => sum + Number(l.split(' ').pop()), 0);",
                  "pm.collectionVariables.set('guildCalls', count('broker_grpc_calls_total', ['target=\"guild-service\"', 'method=\"GetGuild\"', 'code=\"OK\"']));",
                  "pm.collectionVariables.set('rewardCalls', count('broker_grpc_calls_total', ['target=\"user-management-service\"', 'method=\"AdjustCurrency\"']));",
                  "pm.collectionVariables.set('tamagotchiRequests', count('broker_requests_total', ['target=\"tamagotchi-service\"']));",
                  "pm.collectionVariables.set('raidEvents', count('broker_events_published_total', ['topic=\"raid.completed\"', 'source=\"monster-raid-service\"']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{brokerUrl}}/metrics",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "The broker's counters before the raid: GetGuild and AdjustCurrency calls over gRPC, REST requests to Tamagotchi, and raid.completed events."
          },
          "response": []
        },
        {
          "name": "Package Registry creates a raid, through the broker",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('raidId', pm.response.json().raidId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Broker-Key",
                "value": "{{brokerKey}}"
              },
              {
                "key": "X-Service-Key",
                "value": "{{packageRegistryServiceKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configId\": \"cfg-{{runId}}\",\n  \"guildId\": \"{{guildId}}\",\n  \"monsterName\": \"Gateway Golem\",\n  \"maxHp\": 4,\n  \"duration\": 600,\n  \"rewards\": {\n    \"currency\": 7,\n    \"xp\": 3\n  }\n}"
            },
            "url": {
              "raw": "{{brokerUrl}}/services/monster-raid-service/raids",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "services",
                "monster-raid-service",
                "raids"
              ]
            },
            "description": "A service-to-service call through the Message Broker: the broker key plus Package Registry's own X-Service-Key, no player token. Set {{brokerKey}} to BROKER_KEY and {{packageRegistryServiceKey}} to PACKAGE_REGISTRY_MONSTER_RAID_SERVICE_KEY from .env."
          },
          "response": []
        },
