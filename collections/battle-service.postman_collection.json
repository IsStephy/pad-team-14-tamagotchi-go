{
  "info": {
    "name": "Battle Service (Team 14)",
    "description": "Every endpoint of the Battle Service, in an order that runs top to bottom as a complete scenario: a match is created, two turns are played, each rejection path is exercised, one player forfeits, and the match is deleted.\n\nStart the service first with `./run.sh` in the battle-service repo, then hit Run to verify it works. `baseUrl` defaults to http://localhost:8082.\n\nThe battle id is captured into a collection variable as the run progresses, so nothing needs to be filled in by hand.\n\nThis service owns no user or Tamagotchi records: the player ids and combat stats below are supplied by the caller, so the collection runs without User Management or Tamagotchi Service being up.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "player1Id",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "player2Id",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string"
    },
    {
      "key": "outsiderId",
      "value": "99999999-9999-9999-9999-999999999999",
      "type": "string"
    },
    {
      "key": "primaryTamagotchiId",
      "value": "tama-ember",
      "type": "string"
    },
    {
      "key": "secondaryTamagotchiId",
      "value": "tama-ripple",
      "type": "string"
    },
    {
      "key": "opponentTamagotchiId",
      "value": "tama-bramble",
      "type": "string"
    },
    {
      "key": "battleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "missingId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness probe. Answers as soon as the service is up and migrated."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"reports this service\", function () {",
              "    pm.expect(pm.response.json().service).to.eql(\"battle-service\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Combat reference",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/combat/reference",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "combat",
            "reference"
          ]
        },
        "description": "The combat types, boost ids and actions this service accepts, so a client need not hard-code them."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"lists the six elemental types\", function () {",
              "    pm.expect(body.types).to.be.an(\"array\").with.lengthOf(6);",
              "});",
              "pm.test(\"lists the applicable boosts and actions\", function () {",
              "    pm.expect(body.boosts).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(body.actions).to.include.members([\"attack\", \"defend\", \"forfeit\"]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create battle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/battles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "battles"
          ]
        },
        "description": "Starts a match. The top-level Tamagotchi fields are player one's loadout (the shared contract shape); `opponent` is player two's. Player one moves first.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player1Id\": \"{{player1Id}}\",\n  \"player2Id\": \"{{player2Id}}\",\n  \"primaryTamagotchiId\": \"{{primaryTamagotchiId}}\",\n  \"secondaryTamagotchiId\": \"{{secondaryTamagotchiId}}\",\n  \"primaryType\": \"fire\",\n  \"primaryLevel\": 5,\n  \"secondaryType\": \"water\",\n  \"secondaryLevel\": 3,\n  \"boosts\": [\n    \"power_snack\"\n  ],\n  \"opponent\": {\n    \"primaryTamagotchiId\": \"{{opponentTamagotchiId}}\",\n    \"primaryType\": \"nature\",\n    \"primaryLevel\": 4,\n    \"boosts\": [\n      \"iron_shell\"\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responds 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"starts in progress on player one's turn\", function () {",
              "    pm.expect(body.status).to.eql(\"in_progress\");",
              "    pm.expect(body.currentTurn).to.eql(pm.collectionVariables.get(\"player1Id\"));",
              "    pm.expect(body.turnNumber).to.eql(1);",
              "});",
              "pm.test(\"both sides start at full health\", function () {",
              "    pm.expect(body.healthP1).to.be.above(0);",
              "    pm.expect(body.healthP2).to.be.above(0);",
              "});",
              "pm.test(\"carries no result yet\", function () {",
              "    pm.expect(body.result).to.be.undefined;",
              "});",
              "pm.collectionVariables.set(\"battleId\", body.battleId);"
            ]
          }
        }
      ]
    },
