    {
      "name": "Create Raid (internal)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('returns an active raid', function () {",
              "    pm.expect(body).to.have.property('raidId');",
              "    pm.expect(body.status).to.eql('active');",
              "});",
              "// Save the id so the rest of the collection can use it.",
              "pm.collectionVariables.set('raidId', body.raidId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Service-Key",
            "value": "{{packageRegistryServiceKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"configId\": \"cfg-1\",\n  \"guildId\": \"guild-1\",\n  \"monsterName\": \"Overdue Assignment\",\n  \"maxHp\": 100,\n  \"duration\": 3600,\n  \"rewards\": {\n    \"currency\": 10,\n    \"xp\": 5\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/raids",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "raids"
          ]
        },
        "description": "Internal endpoint: only Package Registry may call it, with its service key in X-Service-Key - a player token is never accepted. The key is the {{packageRegistryServiceKey}} collection variable; it must equal PACKAGE_REGISTRY_MONSTER_RAID_SERVICE_KEY in the shared stack's .env (run with `--env-var packageRegistryServiceKey=<key>` in newman, or edit the variable in Postman)."
      },
      "response": []
    },
