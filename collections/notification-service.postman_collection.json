    },
    {
      "name": "Notifications through the gateway",
      "item": [
        {
          "name": "Register my device",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('registered', function () { pm.expect(pm.response.json().status).to.eql('registered'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/register-device",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "register-device"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{playerId}}\",\n  \"fcmToken\": \"fcm-token-{{runId}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "List my notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('an array', function () { pm.expect(body).to.be.an('array'); });",
                  "// Empty for a fresh player; kept for the next request when an event was published.",
                  "pm.collectionVariables.set('notificationId', body.length ? body[0].id : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{playerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{playerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Mark my notification as read (skipped when the inbox is empty)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('notificationId')) {",
                  "    console.log('No notification for this player yet - see the collection description.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('read', function () { pm.expect(pm.response.json().read).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/notifications/{{notificationId}}/read",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}",
                "read"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
