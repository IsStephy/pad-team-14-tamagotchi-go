      },
      "response": []
    },
    {
      "name": "Create Raid Config",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('returns raidConfigId', function () { pm.expect(body).to.have.property('raidConfigId'); });",
              "// Save the id so Activate Raid Config can use it.",
              "pm.collectionVariables.set('raidConfigId', body.raidConfigId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"guildId\": \"{{guildId}}\",\n  \"monsterName\": \"Frost Wyrm\",\n  \"maxHp\": 50000,\n  \"duration\": 3600,\n  \"rewards\": {\n    \"coins\": 500,\n    \"items\": [\"frost-shard\"]\n  },\n  \"createdByAdminId\": \"{{adminId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/raid-configs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "raid-configs"
          ]
        },
        "description": "An admin designs a Monster Raid. `duration` is in seconds. The config is created with status `draft` - it is not live until activated.\n\n`guildId` scopes the raid to one guild: Monster Raid Service requires it when the raid is created, and only that guild's members may join."
      },
      "response": []
    },
    {
      "name": "Activate Raid Config",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('returns a raidId and active status', function () {",
              "    pm.expect(body).to.have.property('raidId');",
              "    pm.expect(body.status).to.eql('active');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/raid-configs/{{raidConfigId}}/activate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "raid-configs",
            "{{raidConfigId}}",
            "activate"
          ]
        },
        "description": "Activates a raid configuration, spinning up a live raid.\n\nThe live raid is created by Monster Raid Service via its internal POST /raids, and that service owns the raidId - this service returns the id it was given. Reactivating a paused config reuses the same raid.\n\nMonster Raid Service is mocked in Lab 1; a monster name starting with 'unavailable' makes the mock refuse, returning 502."
      },
      "response": []
    },
    {
      "name": "Deactivate Raid Config",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('status is inactive', function () { pm.expect(pm.response.json().status).to.eql('inactive'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/raid-configs/{{raidConfigId}}/deactivate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "raid-configs",
            "{{raidConfigId}}",
            "deactivate"
          ]
        },
        "description": "Pauses an active raid without ending it. The raid instance id is kept, so reactivating resumes the same raid rather than creating a new one."
      },
      "response": []
    },
    {
      "name": "Cancel Raid Config",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('status is cancelled', function () { pm.expect(pm.response.json().status).to.eql('cancelled'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Gateway-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/raid-configs/{{raidConfigId}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "raid-configs",
            "{{raidConfigId}}",
            "cancel"
          ]
        },
        "description": "Permanently cancels the config. Any live raid instance is force-ended without rewards, and the config can never be activated again."
      },
      "response": []
    },
