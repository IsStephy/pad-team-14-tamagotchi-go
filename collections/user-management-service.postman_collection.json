        "url": {
          "raw": "{{gatewayUrl}}/users/login",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "users",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username2}}\",\n  \"password\": \"{{password}}\"\n}"
